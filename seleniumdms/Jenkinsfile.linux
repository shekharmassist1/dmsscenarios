// Linux (Ubuntu server) pipeline for seleniumdms. The Windows pipeline stays in 'Jenkinsfile'.
// Needs on the agent: Google Chrome, ODBC Driver 18 for SQL Server, curl, zip.
// Jenkins: credentials 'dms-db' and 'dms-login', Allure tool named 'allure', Email Extension configured.
pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 3, unit: 'HOURS')
    }

    environment {
        // Site under test: change to 'https://stage.massistcrm.com' to run against stage
        DMS_BASE_URL = 'https://stage.massistcrm.com'
        // Test customers (each parallel group uses its own). admin: Demo Dealer 2/3/4; stage: below
        DMS_CUSTOMER_2 = 'Demo Test 1'
        DMS_CUSTOMER_3 = 'Demo Asset'
        DMS_CUSTOMER_4 = 'Pravesh'
        DMS_COMPANY_NAME = 'Demo Distributor 1'
        DB_SERVER = '10.0.2.134'
        DB_NAME   = 'Ma_Live'
        // Jenkins credential with the DB login: 'dms-db' (admin DB) / 'dms-db-stage' (stage DB)
        DB_CREDENTIALS_ID = 'dms-db-stage'
        HEADLESS  = 'true'
    }

    stages {
        stage('Setup Python') {
            steps {
                dir('seleniumdms') {
                    sh '''
                        set -e
                        export PATH="$HOME/.local/bin:$PATH"
                        command -v uv >/dev/null 2>&1 || curl -LsSf https://astral.sh/uv/install.sh | sh
                        [ -x .venv/bin/python ] || uv venv --python 3.12 .venv
                        uv pip install --python .venv/bin/python selenium pytest pytest-xdist pytest-html allure-pytest pdfplumber pyodbc requests python-dotenv
                    '''
                }
            }
        }
        stage('Run Tests') {
            steps {
                dir('seleniumdms') {
                    sh 'rm -rf results.xml report.html allure-results test-reports.zip'
                    withCredentials([
                        usernamePassword(credentialsId: env.DB_CREDENTIALS_ID, usernameVariable: 'DB_USER', passwordVariable: 'DB_PASSWORD'),
                        usernamePassword(credentialsId: 'dms-login', usernameVariable: 'DMS_USERNAME', passwordVariable: 'DMS_PASSWORD')
                    ]) {
                        // 3 workers: one per customer group (dd4 / dd3 / dd2) -- see the xdist_group marks in the tests.
                        sh '.venv/bin/pytest tests -v -n 3 --dist loadgroup --durations=20 --junitxml=results.xml --html=report.html --self-contained-html --alluredir=allure-results'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def testResults = junit allowEmptyResults: true, testResults: 'seleniumdms/results.xml'

                try {
                    allure commandline: 'allure', includeProperties: false, jdk: '', results: [[path: 'seleniumdms/allure-results']]
                } catch (Throwable e) {
                    echo "Allure report not generated: ${e.message}"
                }

                def zipStatus = sh(returnStatus: true, script: 'cd seleniumdms && zip -q test-reports.zip report.html results.xml')
                if (zipStatus != 0) {
                    echo "Could not create test-reports.zip, sending email without attachment"
                }

                def total = testResults ? testResults.totalCount : 0
                def failed = testResults ? testResults.failCount : 0
                def skipped = testResults ? testResults.skipCount : 0
                def passed = total - failed - skipped
                def passRate = total > 0 ? String.format("%.1f", (passed / (float) total) * 100) : "N/A"
                def statusColor = currentBuild.currentResult == 'SUCCESS' ? '#2e7d32' : '#c62828'

                emailext(
                    subject: "Jenkins Build #${env.BUILD_NUMBER} - ${currentBuild.currentResult} - ${env.JOB_NAME}",
                    body: """
                        <div style="font-family: Arial, sans-serif; max-width: 600px;">
                            <h2 style="color: ${statusColor}; margin-bottom: 4px;">Build ${env.BUILD_NUMBER}: ${currentBuild.currentResult}</h2>
                            <p style="color: #555; margin-top:0;">DMS Selenium Scenarios &mdash; ${env.JOB_NAME} (Linux server)</p>
                            <table style="border-collapse: collapse; width: 100%; margin: 16px 0;">
                                <tr style="background:#f5f5f5;"><td style="padding:8px; font-weight:bold;">Total Tests</td><td style="padding:8px;">${total}</td></tr>
                                <tr><td style="padding:8px; font-weight:bold; color:#2e7d32;">Passed</td><td style="padding:8px;">${passed}</td></tr>
                                <tr style="background:#f5f5f5;"><td style="padding:8px; font-weight:bold; color:#c62828;">Failed</td><td style="padding:8px;">${failed}</td></tr>
                                <tr><td style="padding:8px; font-weight:bold; color:#f9a825;">Skipped</td><td style="padding:8px;">${skipped}</td></tr>
                                <tr style="background:#f5f5f5;"><td style="padding:8px; font-weight:bold;">Pass Rate</td><td style="padding:8px;">${passRate}%</td></tr>
                            </table>
                            <p><a href="${env.BUILD_URL}" style="color:#1565c0;">View Build in Jenkins</a></p>
                            <p style="color:#777; font-size:13px;">Full HTML report and JUnit results are attached as test-reports.zip.</p>
                        </div>
                    """,
                    mimeType: 'text/html',
                    to: '$DEFAULT_RECIPIENTS',
                    attachmentsPattern: 'seleniumdms/test-reports.zip'
                )
            }
        }
    }
}
